---
import Base from '../layouts/Base.astro';
import NoteList from '../components/NoteList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getNotes, getProjects } from '../lib/content';

// Elke carousel op de home toont hooguit zoveel blokken.
const HOME_MAX = 5;

const notes = (await getNotes()).slice(0, HOME_MAX);
const projects = (await getProjects()).slice(0, HOME_MAX);
---
<Base description="Notities en projecten van Maikel, developer met C#, .NET en Umbraco.">
  <section class="intro">
    <h1>Hoi, ik ben Maikel</h1>
    <p>Ik ben developer en werk vooral met C#, .NET en Umbraco. Hier laat ik zien wat ik bouw: korte notities over problemen die ik tegenkwam, en de projecten waar ik aan werk.</p>
  </section>
  <section class="rail-section" aria-labelledby="nieuwste-notities">
    <div class="section-head">
      <h2 id="nieuwste-notities">Nieuwste notities</h2>
      <a href="/notes/">Alle notities</a>
    </div>
    <NoteList notes={notes} headingLevel={3} layout="rail" labelledby="nieuwste-notities" />
  </section>
  <section class="rail-section" aria-labelledby="projecten">
    <div class="section-head">
      <h2 id="projecten">Projecten</h2>
      <a href="/projects/">Alle projecten</a>
    </div>
    <ProjectList projects={projects} headingLevel={3} layout="rail" labelledby="projecten" />
  </section>
</Base>
