---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Base title={project.data.title} description={project.data.description}>
  <article>
    <header>
      <h1>{project.data.title}</h1>
      <p class="meta-line">{project.data.year} · {project.data.stack.join(', ')}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {project.data.repo && (
      <footer class="source-links">
        <a href={project.data.repo}>Bekijk het repo op GitHub</a>
      </footer>
    )}
  </article>
</Base>
