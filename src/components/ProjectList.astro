---
import type { Project } from '../lib/content';

interface Props {
  projects: Project[];
  headingLevel?: 2 | 3;
}

const { projects, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---
<ul class="list">
  {projects.map((project) => (
    <li>
      <Heading><a href={`/projects/${project.id}/`}>{project.data.title}</a></Heading>
      <p class="meta-line">{project.data.year} · {project.data.stack.join(', ')}</p>
      <p>{project.data.description}</p>
    </li>
  ))}
</ul>
