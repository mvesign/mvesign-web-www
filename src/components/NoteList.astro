---
import Tags from './Tags.astro';
import type { Note } from '../lib/content';
import { formatDate, isoDate } from '../lib/format';

interface Props {
  notes: Note[];
  headingLevel?: 2 | 3;
}

const { notes, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---
<ul class="list">
  {notes.map((note) => (
    <li>
      <Heading><a href={`/notes/${note.id}/`}>{note.data.title}</a></Heading>
      <p class="meta-line"><time datetime={isoDate(note.data.date)}>{formatDate(note.data.date)}</time></p>
      <p>{note.data.description}</p>
      <Tags tags={note.data.tags} />
    </li>
  ))}
</ul>
